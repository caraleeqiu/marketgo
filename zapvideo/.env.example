# ===== ZapVídeo environment =====
# Todos os serviços leem este arquivo (copie para .env)

# Diretório de dados (SQLite, uploads, vídeos renderizados)
DATA_DIR=./data

# --- LLM (opcional) ---
# Sem a chave, o app entra em "modo manual": o usuário digita o texto do vídeo.
ANTHROPIC_API_KEY=
# Modelo para copywriting/edições (barato e rápido)
AGENT_MODEL=claude-haiku-4-5

# --- Efeitos de vídeo com IA (opcional) ---
# Provider: none | seedance
VIDEO_FX_PROVIDER=none
# Chave para Seedance (via BytePlus/fal.ai) — usada quando VIDEO_FX_PROVIDER=seedance
SEEDANCE_API_KEY=
FAL_KEY=

# --- Transcrição/legendas (opcional, modo depoimento) ---
OPENAI_API_KEY=

# --- Web ---
PORT=3000
# URL pública (usada nos links de compartilhamento wa.me)
PUBLIC_BASE_URL=http://localhost:3000
# Login do painel /admin (HTTP Basic)
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha

# --- Bot WhatsApp (opcional, canal não-oficial — use um número de teste!) ---
ENABLE_BOT=false

# --- Renderização ---
# Executável do Chromium para o Remotion (deixe vazio para download automático)
REMOTION_BROWSER_EXECUTABLE=
RENDER_CONCURRENCY=1
