{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Example combination: layout_type=single + component_type=markdown (e.g. concept summary, narrative recap). NOT a template menu — derive your slot's combination from docs/deriving_artifact_schemas.md (5+1 steps from SOP to schema). If after derivation your slot lands on this combo, you may cp this file as a starting point. Replace YOUR_SLOT_NAME / YOUR_TITLE; wrapper additionalProperties:false stays strict; domain extras live on content.items via additionalProperties:true.",
  "title": "YOUR_TITLE",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "YOUR_SLOT_NAME" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string", "description": "Producing skill name." },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type"],
      "properties": {
        "layout_type": { "const": "single" }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "text", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "markdown" },
          "text": { "type": "string", "minLength": 1 },
          "max_lines": { "type": "integer", "minimum": 1 },
          "detail": { "type": "null" }
        }
      }
    }
  }
}
