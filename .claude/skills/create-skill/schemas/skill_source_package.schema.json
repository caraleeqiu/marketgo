{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillSourcePackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "skill_name", "target_root", "changed_files", "frontmatter", "resource_layout", "activation_note", "source_ready"],
  "properties": {
    "artifact_type": { "const": "skill_source_package" },
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "target_root": { "type": "string", "minLength": 1 },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": { "enum": ["created", "updated", "deleted"] },
          "summary": { "type": "string" }
        }
      }
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "metadata_kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 20 },
        "metadata_kind": { "enum": ["atomic_skill", "composition_skill", "unknown"] },
        "artifact_contract": { "type": "string" }
      }
    },
    "resource_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemas", "templates", "docs", "scripts", "phases"],
      "properties": {
        "schemas": { "type": "array", "items": { "type": "string" } },
        "templates": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } },
        "scripts": { "type": "array", "items": { "type": "string" } },
        "phases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "activation_note": { "type": "string", "minLength": 10 },
    "source_ready": { "type": "boolean" }
  }
}
