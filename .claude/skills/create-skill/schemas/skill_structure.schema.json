{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillStructure",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "skill_name", "target_root", "kind", "file_plan", "artifact_slots", "terminal_slots", "completion_done_when", "validation_plan", "artifact_layout_plan"],
  "properties": {
    "artifact_type": { "const": "skill_structure" },
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "target_root": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["atomic_skill", "composition_skill"] },
    "file_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 3 },
          "action": { "enum": ["create", "update", "delete", "keep"] }
        }
      }
    },
    "artifact_slots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "terminal_slots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "completion_done_when": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "validation_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "runtime_boundaries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_layout_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "display_name", "layout_type", "primary_component_type", "is_segment"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "layout_type": { "enum": ["single", "list", "grid", "form"] },
          "layout_config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index_prefix": { "type": "string", "minLength": 1 },
              "columns": { "type": "integer", "minimum": 1, "maximum": 3 }
            }
          },
          "primary_component_type": { "enum": ["card", "markdown", "code", "image", "video", "music", "form_field"] },
          "card_variant": { "enum": ["portrait", "horizontal", "landscape"] },
          "display_type": { "enum": ["text", "number", "boolean", "badge", "color", "image", "url", "date", "duration"] },
          "is_segment": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "layout_type": { "const": "grid" } }, "required": ["layout_type"] },
            "then": {
              "required": ["layout_config"],
              "properties": { "layout_config": { "required": ["columns"] } }
            }
          },
          {
            "if": { "properties": { "primary_component_type": { "const": "card" } }, "required": ["primary_component_type"] },
            "then": { "required": ["card_variant"] }
          },
          {
            "if": { "properties": { "primary_component_type": { "const": "form_field" } }, "required": ["primary_component_type"] },
            "then": { "required": ["display_type"] }
          }
        ]
      }
    }
  }
}
