{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived combination: layout_type=single + component_type=image + is_segment=false. 单张 9:16 走秀首帧图，是 Phase 4 视频生成的输入锚点。非 segment（终态前的单图，点击=引用进对话）。生成模型与一致性说明走 content.items 的领域字段（additionalProperties:true）。",
  "title": "Outfit Frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "outfit_frame" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string" },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type"],
      "properties": {
        "layout_type": { "const": "single" }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "image_url", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "image" },
          "image_url": { "type": "string" },
          "detail": { "type": "null" }
        }
      }
    }
  }
}
