{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived combination: layout_type=grid + component_type=card + is_segment=false. outfit_frame 现在可含 1-3 张首帧图（用户在 Phase 2 确认门选定给哪几套出图）—— 多张等价并列，用 grid。每张是一张 card：tier 走 title，单品摘要走 subtitle，9:16 走秀图走 media（竖版主体故 variant=portrait），media 类型/模型/主体类型走 tags。点击=引用进对话，非 segment。出图失败的张用 media.state=failed 标记。",
  "title": "Outfit Frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "outfit_frame" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string" },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type", "config"],
      "properties": {
        "layout_type": { "const": "grid" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns"],
          "properties": {
            "columns": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "variant", "title", "subtitle", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "card" },
          "variant": { "const": "portrait" },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["image", "video", "audio"] },
              "url": { "type": "string" },
              "state": { "enum": ["failed"] }
            }
          },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label"],
              "properties": { "label": { "type": "string", "minLength": 1 } }
            }
          },
          "detail": { "type": "null" }
        }
      }
    }
  }
}
