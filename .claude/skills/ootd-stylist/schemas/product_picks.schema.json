{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived combination: layout_type=grid + component_type=card + is_segment=false. product_picks 是为选定穿搭的每个单品搜到的真实产品（产品图 + 名称 + 购买链接 + 参考价），多个等价产品用 grid。每张是 portrait card：产品图走 media，产品名走 title，单品槽位 + 套名走 subtitle，购买链接 + 参考价走 text（用户可见可点），来源/单品类型/套名走 tags。点击=引用进对话，非 segment。搜不到的单品用 media.state=failed 标记。",
  "title": "Product Picks",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "product_picks" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string" },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type", "config"],
      "properties": {
        "layout_type": { "const": "grid" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns"],
          "properties": {
            "columns": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "variant", "title", "subtitle", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "card" },
          "variant": { "const": "portrait" },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["image", "video", "audio"] },
              "url": { "type": "string" },
              "state": { "enum": ["failed"] }
            }
          },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string", "minLength": 1 },
          "text": {
            "type": "string",
            "description": "购买链接与参考价等用户可见、可点击/可复制的信息。搜不到产品时保留原单品文字描述。"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label"],
              "properties": { "label": { "type": "string", "minLength": 1 } }
            }
          },
          "detail": { "type": "null" }
        }
      }
    }
  }
}
