{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived combination: layout_type=single + component_type=video + is_segment=false. 单条终态走秀成片，有自己的播放器 UI，不进 media_player segment 框。引擎名/时长/画幅/quality_tier 等领域字段走 content.items（additionalProperties:true）。",
  "title": "OOTD Video",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "ootd_video" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string" },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type"],
      "properties": {
        "layout_type": { "const": "single" }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "video" },
          "thumbnail_url": { "type": "string" },
          "title": { "type": "string" },
          "duration": { "type": "number", "minimum": 0 },
          "video_url": { "type": "string" },
          "detail": { "type": "null" }
        }
      }
    }
  }
}
