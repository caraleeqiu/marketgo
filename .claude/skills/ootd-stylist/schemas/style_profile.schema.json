{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived combination: layout_type=form + component_type=form_field + is_segment=false. style_profile 是一组标注属性字段，用户审阅并可改气质标签。display_type 用 enum[text,badge]：关键特征类走 text，气质标签/色系/版型这类离散值走 badge。",
  "title": "Style Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "style_profile" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string" },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type"],
      "properties": {
        "layout_type": { "const": "form" }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "key", "value", "display_type", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "form_field" },
          "key": { "type": "string", "minLength": 1 },
          "value": {},
          "display_type": { "enum": ["text", "badge"] },
          "detail": { "type": "null" }
        }
      }
    }
  }
}
