{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Derived per docs/deriving_artifact_schemas.md. SOP 附录 A: 按 5 beat 组织的连贯脚本正文，师傅整体读 → single + markdown + is_segment=false.",
  "title": "NarrationScript",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "display_name", "status", "version", "content_layout", "content"],
  "properties": {
    "slot": { "const": "narration_script" },
    "display_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "verified"] },
    "version": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string", "description": "Producing skill name." },
    "content_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type"],
      "properties": { "layout_type": { "const": "single" } }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "component_type", "text", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component_type": { "const": "markdown" },
          "text": { "type": "string", "minLength": 1, "description": "按 5 beat（Shot 1-5）组织的旁白脚本正文，已嵌入声线 marker（captions_only 时无 marker）；零维修操作指令；反套路 hook；短句；TTS 可念性 spell-out 已处理。" },
          "max_lines": { "type": "integer", "minimum": 1 },
          "detail": { "type": "null" },
          "beat_count": { "const": 5, "description": "固定 5 beat，对应 5 个镜头。" },
          "estimated_duration": { "type": "number", "minimum": 0, "description": "按字数 × 语速估算的秒数。" }
        }
      }
    }
  }
}
